            "index": 0
          }
        ]
      ]
    },
    "Agente IA LevSer": {
      "main": [
        [
          {
            "node": "Enviar Resposta Chatwoot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
