{
  "name": "LevSer Saúde - Agente de Atendimento WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatwoot",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Webhook Chatwoot"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition_event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "message_created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition_msg_type",
              "leftValue": "={{ $json.body.message_type }}",
              "rightValue": "incoming",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition_private",
              "leftValue": "={{ $json.body.private }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Filtro Anti-Loop (Incoming Only)"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.content }}",
        "messages": {
          "messageValues": [
            {
              "type": "System",
              "message": "Você é um assistente inicial da LevSer Saúde. Responda em português, de maneira clara e objetiva, utilizando no máximo duas frases.\n\nA LevSer fica na Avenida Brasil, 173, Jardim Paulista, São Paulo. A Avaliação Estratégica é o primeiro ponto de cuidado para entender o histórico, os objetivos e as possibilidades da pessoa antes da definição da sua jornada.\n\nNão forneça diagnóstico, prescrição ou orientação clínica. Quando não tiver informações suficientes, informe que uma pessoa da equipe continuará o atendimento."
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        500,
        -100
      ],
      "id": "3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "Agente IA LevSer"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        500,
        120
      ],
      "id": "4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "Groq Model",
      "credentials": {
        "groqApi": {
          "id": "jTYKrZrsMiP3mdii",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://levser_chatwoot:3000/api/v1/accounts/{{ $('Webhook Chatwoot').item.json.body.account.id }}/conversations/{{ $('Webhook Chatwoot').item.json.body.conversation.id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"{{ $json.text }}\",\n  \"message_type\": \"outgoing\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -100
      ],
      "id": "5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
      "name": "Enviar Resposta Chatwoot",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ttTRszn6YSLvmvp8",
          "name": "Header Auth account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Chatwoot": {
      "main": [
        [
          {
            "node": "Filtro Anti-Loop (Incoming Only)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtro Anti-Loop (Incoming Only)": {
      "main": [
        [
          {
