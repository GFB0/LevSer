# Variáveis de ambiente essenciais para o Chatwoot Local
SECRET_KEY_BASE=a39c94f0612c6fa5e90d797171e5bd1d34c1df812f86230b429d2f2df31a7c50a41d9990b7a86
FRONTEND_URL=http://localhost:3000

# Banco de Dados Postgres
POSTGRES_HOST=db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=chatwoot_production
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:redispassword@redis:6379/0

# Configurações do Rails
RAILS_ENV=production
RAILS_MAX_THREADS=5
NODE_ENV=production
ENABLE_ACCOUNT_SIGNUP=true

# Storage Local
ACTIVE_STORAGE_SERVICE=local

# Permitir URLs Locais no Webhook (Onde eu errei)
DISABLE_PERMITTED_URL_VALIDATION=true
DISABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_ADDRESS_WEBHOOK=true
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
